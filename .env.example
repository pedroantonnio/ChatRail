# HTTP server
HOST=127.0.0.1
PORT=3333
DATA_DIR=./data

# Provider: auto | wwebjs | baileys | fake
# auto uses an existing Baileys session when present; otherwise whatsapp-web.js.
WA_PROVIDER=auto

# Browser mode for whatsapp-web.js
HEADLESS=true

# Phone normalization
# Optional. Prefer full international numbers; set this only if you want local-number expansion.
DEFAULT_COUNTRY_CODE=

# Outbound safety
ALLOW_UNREGISTERED=false
ALLOW_GROUPS=false
DEDUPE_WINDOW_HOURS=720

# Optional bearer token. Strongly recommended if binding outside loopback.
API_TOKEN=

# Logging
LOG_LEVEL=info

# MCP stdio -> local ChatRail HTTP API
MCP_API_BASE_URL=http://127.0.0.1:3333
MCP_API_TIMEOUT_MS=15000
