{
  "name": "chatrail",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local WhatsApp gateway with HTTP and MCP interfaces for apps, automations, and AI tools",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/cli.js",
    "start:fake": "node src/cli.js --provider=fake",
    "test": "node --test --test-reporter=spec test/*.test.js",
    "test:regression": "node --test --test-reporter=spec test/*.test.js",
    "test:syntax": "node scripts/syntax-check.js",
    "selftest": "node scripts/selftest.js",
    "doctor": "node scripts/doctor.js",
    "provider:smoke": "node scripts/provider-import-smoke.js",
    "verify": "npm run test:syntax && npm test && npm run selftest",
    "stress": "node scripts/stress.js",
    "mcp": "node src/mcp-cli.js",
    "test:mcp": "node --test --test-reporter=spec test/mcp.test.js",
    "verify:mcp": "npm run test:mcp"
  },
  "dependencies": {
    "@hapi/boom": "10.0.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "qrcode-terminal": "0.12.0",
    "whatsapp-web.js": "1.34.7",
    "zod": "3.25.76"
  },
  "keywords": [
    "whatsapp",
    "mcp",
    "model-context-protocol",
    "api",
    "automation",
    "self-hosted",
    "whatsapp-web-js",
    "baileys"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedroantonnio/ChatRail.git"
  },
  "bugs": {
    "url": "https://github.com/pedroantonnio/ChatRail/issues"
  },
  "homepage": "https://github.com/pedroantonnio/ChatRail#readme"
}
