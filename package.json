{
  "name": "@pedroantonnio/chatrail",
  "version": "1.0.1",
  "type": "module",
  "description": "Local WhatsApp gateway with HTTP and MCP interfaces for apps, automations, and AI tools",
  "bin": {
    "chatrail": "src/cli.js"
  },
  "files": [
    "src/",
    "scripts/",
    ".env.example",
    "API.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "KNOWN_UPSTREAM_LIMITATIONS.md",
    "MCP.md",
    "NOTICE.md",
    "SECURITY.md",
    "LICENSE",
    "README.md"
  ],
  "workspaces": [
    "packages/chatrail-mcp"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/cli.js",
    "start:fake": "node src/cli.js start --provider=fake",
    "init": "node src/cli.js init",
    "status": "node src/cli.js status",
    "test": "node --test --test-reporter=spec test/*.test.js",
    "test:regression": "node --test --test-reporter=spec test/*.test.js",
    "test:syntax": "node scripts/syntax-check.js",
    "selftest": "node scripts/selftest.js",
    "doctor": "node scripts/doctor.js",
    "provider:smoke": "node scripts/provider-import-smoke.js",
    "verify": "npm run test:syntax && npm test && npm run selftest",
    "stress": "node scripts/stress.js",
    "mcp": "node src/mcp-cli.js",
    "test:mcp": "node --test --test-reporter=spec test/mcp.test.js",
    "verify:mcp": "npm run test:mcp",
    "pack:check": "npm pack --dry-run && npm pack --workspace @pedroantonnio/chatrail-mcp --dry-run"
  },
  "dependencies": {
    "@hapi/boom": "10.0.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "qrcode-terminal": "0.12.0",
    "whatsapp-web.js": "1.34.7",
    "zod": "3.25.76"
  },
  "keywords": [
    "whatsapp",
    "mcp",
    "model-context-protocol",
    "api",
    "automation",
    "self-hosted",
    "whatsapp-web-js",
    "baileys",
    "codex"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedroantonnio/ChatRail.git"
  },
  "bugs": {
    "url": "https://github.com/pedroantonnio/ChatRail/issues"
  },
  "homepage": "https://github.com/pedroantonnio/ChatRail#readme",
  "publishConfig": {
    "access": "public"
  }
}
